# Copy these into your IntelliJ Run Configuration > Environment variables
# (or export them in your shell). Never commit real values.
DB_URL=jdbc:mysql://localhost:3306/jobtrack?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
# Base64 string, at least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=replace_with_generated_secret
JWT_EXPIRATION_MS=86400000
SPRING_PROFILES_ACTIVE=dev
# First admin account, created on startup if it does not exist (password min 8 chars)
ADMIN_EMAIL=admin@jobtrack.local
ADMIN_PASSWORD=choose_a_strong_password
