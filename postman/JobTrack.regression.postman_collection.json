        "body": {
          "mode": "raw",
          "raw": "{\"companyId\":{{companyId}},\"title\":\"Postman Java Developer\",\"description\":\"Build REST services\",\"location\":\"Pune\",\"jobType\":\"FULL_TIME\",\"skillsRequired\":\"Java, Spring Boot\",\"minCgpa\":7.0,\"salaryLpa\":6.5,\"applicationDeadline\":\"{{jobDeadline}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"jobDeadline\", new Date(Date.now() + 30 * 864e5).toISOString().slice(0, 10));"
            ]
